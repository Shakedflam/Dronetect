# Copy to .env (or .env.local) and adjust for your environment.
# WebSocket origin of the Drontect edge realtime server — host:port only. The
# tablet's /ws path and role=tablet query string are appended by the app.
VITE_REALTIME_SERVER_WS_URL=ws://127.0.0.1:8765
# Access keys are entered at runtime, never stored in VITE_* variables.
# Optional loopback-only simulator development (server also needs its explicit flag):
# VITE_ALLOW_INSECURE_LOCAL=1
# For a cloud-hosted realtime server: VITE_REALTIME_SERVER_WS_URL=wss://<cloud-host>
# (see app/.env.android.example for the packaged-app equivalent)

# Optional: comma-separated STUN/TURN URLs for the WebRTC video viewer's ICE
# config. Only needed once the realtime server and this client aren't on the
# same LAN. Unset falls back to a public STUN server.
# VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
