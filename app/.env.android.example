# Copy to .env.android for a packaged build. Production APKs must use WSS.
# A debug APK may temporarily use ws://<development-PC-LAN-IP>:8765.
VITE_REALTIME_SERVER_WS_URL=wss://realtime.example.com

# Optional comma-separated ICE servers for the WebRTC video viewer. Unset
# falls back to a public STUN server, sufficient for many deployments; once a
# real device is off-LAN from the realtime server, a credentialed TURN server
# may be needed too (see docs/deployment.md).
# VITE_WEBRTC_STUN_URLS=stun:stun.example.com:3478,turn:turn.example.com:3478
